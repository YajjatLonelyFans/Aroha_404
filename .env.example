# ---------- Backend (backend/.env) ----------
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aroha_db

# Open-Meteo (no key needed for non-commercial use)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Nominatim (must identify the app)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Aroha-HackCBS9/0.1 (contact: <team-email>)

# Meko (hosted MCP)
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_API_KEY=<from-meko-portal>
MEKO_ENABLED_DEFAULT=true

# LLM provider (choose one)
LLM_PROVIDER=<provider>
LLM_API_KEY=<key>
LLM_MODEL=<model-id>

# Mocks (development only; UI labels them)
USE_MOCK_WEATHER=false
USE_MOCK_MEKO=false
USE_MOCK_LLM=false

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Public tile URL; if the provider needs a token, use a URL-restricted public token only
NEXT_PUBLIC_MAP_TILE_URL=<satellite-tile-url-template>
NEXT_PUBLIC_MAP_ATTRIBUTION=<provider attribution text>
